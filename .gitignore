data/dataset_construction/02_negative_sampling/**/*.tsv.gz
data/dataset_construction/02_negative_sampling/**/*.parquet
data/dataset_construction/02_negative_sampling/**/*.json
data/dataset_construction/02_negative_sampling/candidates/
!data/dataset_construction/02_negative_sampling/**/.gitkeep

# Stage 3 Homology Clustering outputs (reproducible via pipeline scripts)
data/dataset_construction/03_homology_clustering/**/*.tsv
data/dataset_construction/03_homology_clustering/**/*.md
data/dataset_construction/03_homology_clustering/**/mappings/
data/dataset_construction/03_homology_clustering/**/mmseqs_db/
!data/dataset_construction/03_homology_clustering/**/.gitkeep
