#!/bin/bash
# ==============================================================================
# PBS Job Script: Run Remaining DeepAraPPI Benchmarks (Tasks 3, 4 & Evaluation)
# Evaluates:
#   1. Task 3 (C3 test sample, 33,099 pairs - Both Unseen Proteins, ~75 mins)
#   2. Task 4 (Rice cross-species, 6,721 pairs, ~15 mins)
#   3. Comprehensive Evaluation of all 4 Tasks (C1, C2, C3, Rice)
# ==============================================================================
#PBS -N pplm_remaining_benchmarks
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o pplm_remaining_benchmarks.log

if [ -d "$PBS_O_WORKDIR/scripts" ]; then
    cd "$PBS_O_WORKDIR"
elif [ -d "$HOME/AraPPLM/scripts" ]; then
    cd "$HOME/AraPPLM"
elif [ -d "$HOME/AIS5281-Plant-PPLM/scripts" ]; then
    cd "$HOME/AIS5281-Plant-PPLM"
fi

echo "=== Continuation Benchmark Job started on $(hostname) at $(date) ==="
echo "Working directory: $(pwd)"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

nvidia-smi

# Load conda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
fi

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
conda activate PPLM_NSCC_A100

echo "Python binary: $(which python)"
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

OUTPUT_DIR="results/DeepAraPPI"
mkdir -p "$OUTPUT_DIR"

ARABIDOPSIS_SEQ_DB="data/arabidopsis/uniprot_final.pkl"
RICE_SEQ_DB="data/rice/uniprot_rice_final.pkl"
BATCH_SIZE=4

# ------------------------------------------------------------------------------
# 1. Benchmark Task 3: C3 Sample (Both Unseen Proteins, ~33k pairs)
# ------------------------------------------------------------------------------
echo -e "\n>>> [3/4] Running Benchmark: Task 3 (C3 Sample - Both Unseen) <<<"
python -u scripts/batch_predict.py \
    --input data/DeepAraPPI/c3_ppi_sample_DeepAraPPI.txt \
    --output "$OUTPUT_DIR/deepara_c3_scores.csv" \
    --batch_size $BATCH_SIZE \
    --gpu_id 0 \
    --seq_db "$ARABIDOPSIS_SEQ_DB"

# ------------------------------------------------------------------------------
# 2. Benchmark Task 4: Rice Cross-Species Generalization (~6.7k pairs)
# ------------------------------------------------------------------------------
if [ -f "$RICE_SEQ_DB" ]; then
    echo -e "\n>>> [4/4] Running Benchmark: Task 4 (Rice Cross-Species) <<<"
    python -u scripts/batch_predict.py \
        --input data/DeepAraPPI/all_rice_positive_negative_DeepAraPPI.txt \
        --output "$OUTPUT_DIR/deepara_rice_scores.csv" \
        --batch_size $BATCH_SIZE \
        --gpu_id 0 \
        --seq_db "$RICE_SEQ_DB"
else
    echo -e "\n⚠️ Rice sequence database not found at $RICE_SEQ_DB. Skipping Task 4."
fi

# ------------------------------------------------------------------------------
# 3. Evaluate All 4 Prediction Datasets Against DeepAraPPI Baselines
# ------------------------------------------------------------------------------
echo -e "\n>>> Running Comprehensive 4-Task Evaluation <<<"
python -u scripts/evaluate_pplm.py \
    --c1 "$OUTPUT_DIR/deepara_c1_scores.csv" \
    --c2 "$OUTPUT_DIR/deepara_c2_scores.csv" \
    --c3 "$OUTPUT_DIR/deepara_c3_scores.csv" \
    --rice "$OUTPUT_DIR/deepara_rice_scores.csv" \
    --output_dir "$OUTPUT_DIR"

echo "=== All Benchmarks Completed at $(date) ==="
