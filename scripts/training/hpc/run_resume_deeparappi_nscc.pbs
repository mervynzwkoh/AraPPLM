#!/bin/bash
# ==============================================================================
# PBS Job Script: Resume DeepAraPPI Training Pipeline from Stage 3
# Stages 1 (C1 feature extraction) and 2 (MLP training) already completed.
# This script:
#   - Ensures test features (C2, C3, Rice) are pre-extracted (--resume)
#   - Stage 3: Selects top-5 models per mode (mean, max, min)
#   - Stage 4: Fast batched evaluation across all 6 pooling configurations
#   - Stage 5: Comprehensive metrics & multi-pooling ablation summary
# ==============================================================================
#PBS -N pplm_deeparappi_resume
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o pplm_deeparappi_resume.log

if [ -d "$PBS_O_WORKDIR/scripts" ]; then
    cd "$PBS_O_WORKDIR"
elif [ -d "$HOME/AraPPLM/scripts" ]; then
    cd "$HOME/AraPPLM"
elif [ -d "$HOME/AIS5281-Plant-PPLM/scripts" ]; then
    cd "$HOME/AIS5281-Plant-PPLM"
fi

echo "=== Resume Pipeline (Stages 3-5) started on $(hostname) at $(date) ==="
echo "Working directory: $(pwd)"
nvidia-smi

if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
fi

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
conda activate PPLM_NSCC_A100

echo "Python binary: $(which python)"
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

if [ -d "data/legacy_benchmarks/DeepAraPPI" ]; then
    DATA_DIR="data/legacy_benchmarks/DeepAraPPI"
else
    DATA_DIR="data/DeepAraPPI"
fi

C2_DATASET="$DATA_DIR/c2_ppi_sample_DeepAraPPI.txt"
C3_DATASET="$DATA_DIR/c3_ppi_sample_DeepAraPPI.txt"
RICE_DATASET="$DATA_DIR/all_rice_positive_negative_DeepAraPPI.txt"

SEQ_DB="data/arabidopsis/uniprot_final.pkl"
RICE_SEQ_DB="data/rice/uniprot_rice_final.pkl"

FEAT_DIR_C2="features/DeepAraPPI_C2"
FEAT_DIR_C3="features/DeepAraPPI_C3"
FEAT_DIR_RICE="features/DeepAraPPI_Rice"

MODEL_DIR="models/DeepAraPPI"
RESULT_DIR="results/DeepAraPPI/pretrained"
ENSEMBLE_WEIGHTS="$MODEL_DIR/ppi_plant_models.pkl"

mkdir -p "$FEAT_DIR_C2" "$FEAT_DIR_C3" "$FEAT_DIR_RICE" "$RESULT_DIR"

# ==============================================================================
# Stage 3: Select Top-5 Models per Pooling Mode
# ==============================================================================
echo -e "\n>>> [Stage 3] Selecting top-5 models per pooling mode <<<"
python -u scripts/training/select_top_models.py \
    --model_dir "$MODEL_DIR" \
    --output "$ENSEMBLE_WEIGHTS" \
    --top_k 5 \
    --modes mean max min \
    --seed_round 1

MEAN_LIST="$MODEL_DIR/PPLM-PPI.inter_intra_attn_embed.mean.round_1.top5_list"
MAX_LIST="$MODEL_DIR/PPLM-PPI.inter_intra_attn_embed.max.round_1.top5_list"
MIN_LIST="$MODEL_DIR/PPLM-PPI.inter_intra_attn_embed.min.round_1.top5_list"

# ==============================================================================
# Ensure Held-Out Test Features Are Extracted
# ==============================================================================
echo -e "\n>>> Ensuring test-set .pkl features are extracted (--resume) <<<"
python -u scripts/training/extract_features.py \
    --input "$C2_DATASET" --output_dir "$FEAT_DIR_C2" --seq_db "$SEQ_DB" --gpu_id 0 --resume
python -u scripts/training/extract_features.py \
    --input "$C3_DATASET" --output_dir "$FEAT_DIR_C3" --seq_db "$SEQ_DB" --gpu_id 0 --resume
if [ -f "$RICE_SEQ_DB" ]; then
    python -u scripts/training/extract_features.py \
        --input "$RICE_DATASET" --output_dir "$FEAT_DIR_RICE" --seq_db "$RICE_SEQ_DB" --gpu_id 0 --resume
fi

# ==============================================================================
# Stage 4: Fast Batched Testing Across All 6 Pooling Combinations
# ==============================================================================
run_test_suite() {
    local split_tag="$1"
    local input_tsv="$2"
    local feat_dir="$3"

    echo -e "\n>>> [Stage 4] Testing $split_tag across all 6 pooling combinations <<<"

    if [ -f "$MEAN_LIST" ]; then
        python -u scripts/training/test_ppi_head.py \
            --input "$input_tsv" --feat_dir "$feat_dir" --mean_path "$MEAN_LIST" \
            --output "$RESULT_DIR/deepara_${split_tag}_mean_scores.csv" \
            --out_path_prefix "$RESULT_DIR/deepara_${split_tag}_mean" \
            --test_name "$split_tag" --order_mode both --batch_size 512 --gpu_id 0
    fi
    if [ -f "$MAX_LIST" ]; then
        python -u scripts/training/test_ppi_head.py \
            --input "$input_tsv" --feat_dir "$feat_dir" --max_path "$MAX_LIST" \
            --output "$RESULT_DIR/deepara_${split_tag}_max_scores.csv" \
            --out_path_prefix "$RESULT_DIR/deepara_${split_tag}_max" \
            --test_name "$split_tag" --order_mode both --batch_size 512 --gpu_id 0
    fi
    if [ -f "$MIN_LIST" ]; then
        python -u scripts/training/test_ppi_head.py \
            --input "$input_tsv" --feat_dir "$feat_dir" --min_path "$MIN_LIST" \
            --output "$RESULT_DIR/deepara_${split_tag}_min_scores.csv" \
            --out_path_prefix "$RESULT_DIR/deepara_${split_tag}_min" \
            --test_name "$split_tag" --order_mode both --batch_size 512 --gpu_id 0
    fi
    if [ -f "$MEAN_LIST" ] && [ -f "$MAX_LIST" ]; then
        python -u scripts/training/test_ppi_head.py \
            --input "$input_tsv" --feat_dir "$feat_dir" \
            --mean_path "$MEAN_LIST" --max_path "$MAX_LIST" \
            --output "$RESULT_DIR/deepara_${split_tag}_combine_mean_max_scores.csv" \
            --out_path_prefix "$RESULT_DIR/deepara_${split_tag}_combine_mean_max" \
            --test_name "$split_tag" --order_mode both --batch_size 512 --gpu_id 0
    fi
    if [ -f "$MEAN_LIST" ] && [ -f "$MAX_LIST" ] && [ -f "$MIN_LIST" ]; then
        python -u scripts/training/test_ppi_head.py \
            --input "$input_tsv" --feat_dir "$feat_dir" \
            --mean_path "$MEAN_LIST" --max_path "$MAX_LIST" --min_path "$MIN_LIST" \
            --output "$RESULT_DIR/deepara_${split_tag}_combine_mean_max_min_scores.csv" \
            --out_path_prefix "$RESULT_DIR/deepara_${split_tag}_combine_mean_max_min" \
            --test_name "$split_tag" --order_mode both --batch_size 512 --gpu_id 0
    fi
    if [ -f "$MEAN_LIST" ] && [ -f "$MIN_LIST" ]; then
        python -u scripts/training/test_ppi_head.py \
            --input "$input_tsv" --feat_dir "$feat_dir" \
            --mean_path "$MEAN_LIST" --min_path "$MIN_LIST" \
            --output "$RESULT_DIR/deepara_${split_tag}_combine_mean_min_scores.csv" \
            --out_path_prefix "$RESULT_DIR/deepara_${split_tag}_combine_mean_min" \
            --test_name "$split_tag" --order_mode both --batch_size 512 --gpu_id 0
    fi
}

run_test_suite "c2" "$C2_DATASET" "$FEAT_DIR_C2"
run_test_suite "c3" "$C3_DATASET" "$FEAT_DIR_C3"
if [ -f "$RICE_SEQ_DB" ]; then
    run_test_suite "rice" "$RICE_DATASET" "$FEAT_DIR_RICE"
fi

# ==============================================================================
# Stage 5: Evaluate & Compare Against Baselines + Multi-Pooling Ablation
# ==============================================================================
echo -e "\n>>> [Stage 5] Running evaluation metrics and pooling ablation summary <<<"
python -u scripts/benchmarking/evaluate_pplm.py \
    --c2 "$RESULT_DIR/deepara_c2_combine_mean_max_scores.csv" \
    --c3 "$RESULT_DIR/deepara_c3_combine_mean_max_scores.csv" \
    --rice "$RESULT_DIR/deepara_rice_combine_mean_max_scores.csv" \
    --pooling_ablation_dir "$RESULT_DIR" \
    --suite DeepAraPPI \
    --output_dir "$RESULT_DIR"

echo "=== Resume Pipeline Complete at $(date) ==="
