#!/bin/bash
# ==============================================================================
# submit_pair_clustering_hpc.pbs
# ==============================================================================
# PBS Batch Submission Script for NSCC ASPIRE 2A / PBS Pro Clusters
# Executes MMseqs2 all-vs-all search and pair-level redundancy parameter sweep.
#
# Submit with:
#   qsub scripts/dataset_construction/submit_pair_clustering_hpc.pbs
#
# Check status:
#   qstat -u $USER
# ==============================================================================

#PBS -N ara_ppi_clustering
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o logs_pair_clustering.log

# Move to job submission directory
cd "${PBS_O_WORKDIR:-$PWD}"

echo "========================================================================"
echo "Job started on: $(hostname) at $(date)"
echo "Working directory: $(pwd)"
echo "Job ID: ${PBS_JOBID:-LOCAL}"
echo "========================================================================"

# Load modules / Conda environment
# 1. Source user bashrc to inherit conda init
if [ -f "$HOME/.bashrc" ]; then
    source "$HOME/.bashrc"
fi

# 2. Source conda profile script if available
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
elif [ -f "/app1/common/miniconda3/etc/profile.d/conda.sh" ]; then
    source "/app1/common/miniconda3/etc/profile.d/conda.sh"
else
    module load miniforge3 2>/dev/null || module load miniconda3 2>/dev/null || true
fi

# 3. Add mmseqs2_env bin directory to PATH (provides mmseqs binary)
conda activate mmseqs2_env 2>/dev/null || true
for env_dir in \
    "$HOME/.conda/envs/mmseqs2_env/bin" \
    "$HOME/miniconda3/envs/mmseqs2_env/bin" \
    "$HOME/miniforge3/envs/mmseqs2_env/bin" \
    "/app1/common/miniconda3/envs/mmseqs2_env/bin"; do
    if [ -f "${env_dir}/mmseqs" ]; then
        echo "Found mmseqs at: ${env_dir}/mmseqs"
        export PATH="${env_dir}:$PATH"
        break
    fi
done

# 4. Activate python11 (provides Python 3.11 environment)
conda activate python11 2>/dev/null || true
for py_dir in \
    "$HOME/.conda/envs/python11/bin" \
    "$HOME/miniconda3/envs/python11/bin" \
    "$HOME/miniforge3/envs/python11/bin" \
    "/app1/common/miniconda3/envs/python11/bin"; do
    if [ -f "${py_dir}/python3" ]; then
        echo "Found python3 at: ${py_dir}/python3"
        export PATH="${py_dir}:$PATH"
        break
    fi
done

# Diagnostics
echo "Current PATH: $PATH"
which mmseqs || echo "ERROR: mmseqs still not found in PATH"
which python3 || echo "ERROR: python3 not found in PATH"
python3 --version 2>/dev/null || true

# Set number of threads to match ncpus requested
export THREADS=16

# Execute pipeline script
bash scripts/dataset_construction/run_pair_clustering_pipeline.sh

echo "========================================================================"
echo "Job completed at $(date)"
echo "========================================================================"
