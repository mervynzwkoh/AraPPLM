#!/bin/bash
# ==============================================================================
# submit_cluster_candidate_negatives_hpc.pbs
# ==============================================================================
# PBS Batch Submission Script for NSCC ASPIRE 2A / PBS Pro Clusters
# Executes Stage 2.6 Candidate Negative Pair-Level Redundancy Reduction:
#   - Evaluates pair similarity S(P_i, P_j) >= 0.50 (cmin=0.80, evalue <= 1e-3).
#   - Reduces paralogous redundancy among 101.85M clean candidate negatives.
#   - Yields the final non-redundant negative candidate pool.
#
# Submit with:
#   qsub scripts/dataset_construction/submit_cluster_candidate_negatives_hpc.pbs
#
# Check status:
#   qstat -u $USER
#
# Monitor log:
#   tail -f logs_cluster_candidate_negatives.log
# ==============================================================================

#PBS -N ara_neg_clustering
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o logs_cluster_candidate_negatives.log

# Move to job submission directory
cd "${PBS_O_WORKDIR:-$PWD}"

echo "========================================================================"
echo "Job started on: $(hostname) at $(date)"
echo "Working directory: $(pwd)"
echo "Job ID: ${PBS_JOBID:-LOCAL}"
echo "========================================================================"

# Execute the pipeline runner
bash scripts/dataset_construction/run_cluster_candidate_negatives_hpc.sh

EXIT_CODE=$?
echo ""
echo "========================================================================"
echo "Job finished with exit code ${EXIT_CODE} at $(date)"
echo "========================================================================"

exit ${EXIT_CODE}
