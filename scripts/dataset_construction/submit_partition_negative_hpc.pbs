#!/bin/bash
# ==============================================================================
# submit_partition_negative_hpc.pbs
# ==============================================================================
# PBS Batch Submission Script for NSCC ASPIRE 2A / PBS Pro Clusters
# Executes Stage 2.7 Negative PPI Benchmark Partitioning (1:10 Ratio):
#   - Partitions non-redundant negatives into C1, C2, C3, and C4 splits.
#   - Generates individual negative TSVs and combined benchmark TSVs (Pos + Neg).
#   - Audits all 9 strict graph-theoretic integrity rules.
#
# Submit with:
#   qsub scripts/dataset_construction/submit_partition_negative_hpc.pbs
#
# Check status:
#   qstat -u $USER
#
# Monitor log:
#   tail -f logs_partition_negative.log
# ==============================================================================

#PBS -N ara_neg_partition
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs_partition_negative.log

# Move to job submission directory
cd "${PBS_O_WORKDIR:-$PWD}"

echo "========================================================================"
echo "Job started on: $(hostname) at $(date)"
echo "Working directory: $(pwd)"
echo "Job ID: ${PBS_JOBID:-LOCAL}"
echo "========================================================================"

# Execute the pipeline runner
bash scripts/dataset_construction/run_partition_negative_hpc.sh

EXIT_CODE=$?
echo ""
echo "========================================================================"
echo "Job finished with exit code ${EXIT_CODE} at $(date)"
echo "========================================================================"

exit ${EXIT_CODE}
