#!/bin/bash
# ==============================================================================
# PBS Job Script: Run ESMAraPPI Benchmarks (C2 & C3) on NSCC ASPIRE 2A (A100 GPU)
# Evaluates:
#   1. ESMAraPPI Task C2 (One Unseen Protein, 37,444 pairs, ~80 mins)
#   2. ESMAraPPI Task C3 (Both Unseen Proteins, 8,866 pairs, ~20 mins)
#   3. Comprehensive Evaluation against ESMAraPPI, TAGPPI, PIPR, and D-SCRIPT baselines
# ==============================================================================
#PBS -N pplm_esmarappi_benchmarks
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -o pplm_esmarappi_benchmarks.log

if [ -d "$PBS_O_WORKDIR/scripts" ]; then
    cd "$PBS_O_WORKDIR"
elif [ -d "$HOME/AraPPLM/scripts" ]; then
    cd "$HOME/AraPPLM"
elif [ -d "$HOME/AIS5281-Plant-PPLM/scripts" ]; then
    cd "$HOME/AIS5281-Plant-PPLM"
fi

echo "=== ESMAraPPI Benchmark Job started on $(hostname) at $(date) ==="
echo "Working directory: $(pwd)"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

nvidia-smi

# Load conda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
fi

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
conda activate PPLM_NSCC_A100

echo "Python binary: $(which python)"
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

OUTPUT_DIR="results/ESMAraPPI"
mkdir -p "$OUTPUT_DIR"

ARABIDOPSIS_SEQ_DB="data/arabidopsis/uniprot_final.pkl"
BATCH_SIZE=4

# ------------------------------------------------------------------------------
# 1. Benchmark Task 1: ESMAraPPI C2 Test Set (One Unseen Protein, 37,444 pairs)
# ------------------------------------------------------------------------------
echo -e "\n>>> [1/2] Running Benchmark: ESMAraPPI C2 (One Unseen Protein) <<<"
python -u scripts/batch_predict.py \
    --input data/ESMAraPPI/c2Pred.txt \
    --output "$OUTPUT_DIR/esmarappi_c2_scores.csv" \
    --batch_size $BATCH_SIZE \
    --gpu_id 0 \
    --seq_db "$ARABIDOPSIS_SEQ_DB"

# ------------------------------------------------------------------------------
# 2. Benchmark Task 2: ESMAraPPI C3 Test Set (Both Unseen Proteins, 8,866 pairs)
# ------------------------------------------------------------------------------
echo -e "\n>>> [2/2] Running Benchmark: ESMAraPPI C3 (Both Unseen Proteins) <<<"
python -u scripts/batch_predict.py \
    --input data/ESMAraPPI/c3Pred.txt \
    --output "$OUTPUT_DIR/esmarappi_c3_scores.csv" \
    --batch_size $BATCH_SIZE \
    --gpu_id 0 \
    --seq_db "$ARABIDOPSIS_SEQ_DB"

# ------------------------------------------------------------------------------
# 3. Evaluate Predictions Against ESMAraPPI Literature Baselines
# ------------------------------------------------------------------------------
echo -e "\n>>> Running Comprehensive ESMAraPPI Evaluation <<<"
python -u scripts/evaluate_pplm.py \
    --esm_c2 "$OUTPUT_DIR/esmarappi_c2_scores.csv" \
    --esm_c3 "$OUTPUT_DIR/esmarappi_c3_scores.csv" \
    --output_dir "$OUTPUT_DIR"

echo "=== ESMAraPPI Benchmarks Completed at $(date) ==="
