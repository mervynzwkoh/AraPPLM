#!/bin/bash
# ==============================================================================
# PBS Job Script: Train PPLM-PPI Head on ESMAraPPI C1 Dataset
# NSCC ASPIRE 2A (NVIDIA A100 40GB)
#
# End-to-end pipeline:
#   Stage 1: Extract PPLM features for ESMAraPPI C1 (38,709 pairs)
#   Stage 2: Train PPI MLP head (10-fold CV × 2 pooling modes)
#   Stage 3: Select top-5 models → ensemble weights
#   Stage 4: Evaluate on ESMAraPPI C2 and C3 test sets
#   Stage 5: Run evaluation metrics
#
# NOTE: Requires ESMAraPPI C1 training data file at:
#   data/ESMAraPPI/c1_ppi_sample_ESMAraPPI.txt
# Format: Protein1\tProtein2\tlabel (same as DeepAraPPI)
# Source: ESMAraPPI paper supplementary / GitHub
# ==============================================================================
#PBS -N pplm_train_esmarappi
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o pplm_train_esmarappi.log

# Navigate to project root
if [ -d "$PBS_O_WORKDIR/scripts" ]; then
    cd "$PBS_O_WORKDIR"
elif [ -d "$HOME/AraPPLM/scripts" ]; then
    cd "$HOME/AraPPLM"
elif [ -d "$HOME/AIS5281-Plant-PPLM/scripts" ]; then
    cd "$HOME/AIS5281-Plant-PPLM"
fi

echo "=== Plant-PPLM Training (ESMAraPPI C1) started on $(hostname) at $(date) ==="
echo "Working directory: $(pwd)"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
nvidia-smi

# Load conda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
fi

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
conda activate PPLM_NSCC_A100

echo "Python binary: $(which python)"
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

# ==============================================================================
# Configuration
# ==============================================================================
C1_DATASET="data/ESMAraPPI/c1_Train.txt"
SEQ_DB="data/arabidopsis/uniprot_final.pkl"
FEAT_DIR="features/ESMAraPPI_C1"
MODEL_DIR="models/ESMAraPPI"
RESULT_DIR="results/ESMAraPPI"
ENSEMBLE_WEIGHTS="models/ESMAraPPI/ppi_plant_models.pkl"

# Verify C1 training data exists
if [ ! -f "$C1_DATASET" ]; then
    echo "ERROR: ESMAraPPI C1 training data not found at: $C1_DATASET"
    echo "Please obtain this file from the ESMAraPPI paper supplementary data"
    echo "and place it at the path above in TSV format (Protein1\tProtein2\tlabel)."
    exit 1
fi

mkdir -p "$FEAT_DIR" "$MODEL_DIR" "$RESULT_DIR"

# ==============================================================================
# Stage 1: Extract PPLM Features for ESMAraPPI C1 Training Pairs
# ==============================================================================
echo -e "\n>>> [Stage 1] Extracting PPLM features for ESMAraPPI C1 <<<"
python -u scripts/training/extract_features.py \
    --input "$C1_DATASET" \
    --output_dir "$FEAT_DIR" \
    --seq_db "$SEQ_DB" \
    --gpu_id 0 \
    --resume

echo "Stage 1 complete. Feature files in $FEAT_DIR"
echo "Feature count: $(ls -1 $FEAT_DIR/*.pkl 2>/dev/null | wc -l)"

# ==============================================================================
# Stage 2: Train PPI Head (10-fold CV × mean + max pooling)
# ==============================================================================
echo -e "\n>>> [Stage 2] Training PPI head (mean pooling, 10-fold CV) <<<"
python -u scripts/training/train_ppi_head.py \
    --feat_dir "$FEAT_DIR" \
    --output_dir "$MODEL_DIR" \
    --mode mean \
    --n_folds 10 \
    --epochs 15 \
    --batch_size 512 \
    --learning_rate 5e-5 \
    --gpu_id 0

echo -e "\n>>> [Stage 2] Training PPI head (max pooling, 10-fold CV) <<<"
python -u scripts/training/train_ppi_head.py \
    --feat_dir "$FEAT_DIR" \
    --output_dir "$MODEL_DIR" \
    --mode max \
    --n_folds 10 \
    --epochs 15 \
    --batch_size 512 \
    --learning_rate 5e-5 \
    --gpu_id 0

# ==============================================================================
# Stage 3: Select Top-5 Models per Pooling Mode
# ==============================================================================
echo -e "\n>>> [Stage 3] Selecting top-5 models per pooling mode <<<"
python -u scripts/training/select_top_models.py \
    --model_dir "$MODEL_DIR" \
    --output "$ENSEMBLE_WEIGHTS" \
    --top_k 5 \
    --modes mean max

# ==============================================================================
# Stage 4: Evaluate on ESMAraPPI Held-Out Test Sets
# ==============================================================================
echo -e "\n>>> [Stage 4a] Testing on ESMAraPPI C2 (One Unseen Protein) <<<"
python -u scripts/training/test_ppi_head.py \
    --input data/ESMAraPPI/c2Pred.txt \
    --output "$RESULT_DIR/esmarappi_c2_plant_scores.csv" \
    --model_weights "$ENSEMBLE_WEIGHTS" \
    --seq_db "$SEQ_DB" \
    --gpu_id 0

echo -e "\n>>> [Stage 4b] Testing on ESMAraPPI C3 (Both Unseen Proteins) <<<"
python -u scripts/training/test_ppi_head.py \
    --input data/ESMAraPPI/c3Pred.txt \
    --output "$RESULT_DIR/esmarappi_c3_plant_scores.csv" \
    --model_weights "$ENSEMBLE_WEIGHTS" \
    --seq_db "$SEQ_DB" \
    --gpu_id 0

# ==============================================================================
# Stage 5: Evaluate & Compare Against Baselines
# ==============================================================================
echo -e "\n>>> [Stage 5] Running evaluation metrics <<<"
python -u scripts/benchmarking/evaluate_pplm.py \
    --esm_c2 "$RESULT_DIR/esmarappi_c2_plant_scores.csv" \
    --esm_c3 "$RESULT_DIR/esmarappi_c3_plant_scores.csv" \
    --output_dir "$RESULT_DIR"

echo "=== ESMAraPPI Training Pipeline Complete at $(date) ==="
