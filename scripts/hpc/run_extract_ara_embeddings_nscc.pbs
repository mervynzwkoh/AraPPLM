#!/bin/bash
# ==============================================================================
# PBS Job Script: Extract PPLM Paired Embeddings on NSCC ASPIRE 2A (NVIDIA A100)
# ==============================================================================
#PBS -N extract_ara_pplm_embeddings
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o extract_ara_pplm_embeddings.log

# ------------------------------------------------------------------------------
# 1. Working Directory
# ------------------------------------------------------------------------------
cd $PBS_O_WORKDIR || exit 1
echo "=== Job started on $(hostname) at $(date) ==="
echo "Working directory: $(pwd)"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

# ------------------------------------------------------------------------------
# 2. Check GPU Environment
# ------------------------------------------------------------------------------
nvidia-smi

# ------------------------------------------------------------------------------
# 3. Load Conda Environment
# ------------------------------------------------------------------------------
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
elif [ -f "/app1/common/miniconda3/etc/profile.d/conda.sh" ]; then
    source "/app1/common/miniconda3/etc/profile.d/conda.sh"
else
    module load miniforge3 2>/dev/null || module load miniconda3 2>/dev/null
fi

conda activate PPLM_NSCC_A100

echo "Python binary: $(which python)"
python -c "import torch; print('PyTorch Version:', torch.__version__, '| CUDA available:', torch.cuda.is_available(), '| Device count:', torch.cuda.device_count())"

# ------------------------------------------------------------------------------
# 4. Execute PPLM Embedding Extraction
# ------------------------------------------------------------------------------
INPUT_DATA="data/processed/arabidopsis/ara_positive_pairs_deduplicated.parquet"
OUTPUT_NPY="data/processed/arabidopsis/ara_positive_embeddings_2560d.npy"
OUTPUT_META="data/processed/arabidopsis/ara_positive_embeddings_meta.parquet"
SEQ_DB="data/arabidopsis/uniprot_final.pkl"
BATCH_SIZE=8

mkdir -p data/processed/arabidopsis

echo "Running PPLM paired embedding extraction on: $INPUT_DATA"
python scripts/hpc/extract_ara_pplm_embeddings.py \
    --input "$INPUT_DATA" \
    --seq_db "$SEQ_DB" \
    --output "$OUTPUT_NPY" \
    --meta_output "$OUTPUT_META" \
    --batch_size $BATCH_SIZE \
    --max_pair_len 1020 \
    --device cuda

echo "=== Job finished at $(date) ==="
