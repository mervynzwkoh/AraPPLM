#!/bin/bash
# ==============================================================================
# PBS Job Script: Run All DeepAraPPI Benchmarks on NSCC ASPIRE 2A (NVIDIA A100)
# Evaluates:
#   1. Task 1 (C1 test sample, ~1k pairs)
#   2. Task 2 (C2 test sample, ~3k pairs - One Unseen Protein)
#   3. Task 3 (C3 test sample, ~1.5k pairs - Both Unseen Proteins)
#   4. Task 4 (Rice cross-species, ~6.7k pairs)
# ==============================================================================
#PBS -N pplm_deepara_benchmarks
#PBS -P personal-e0969134
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o pplm_all_benchmarks.log

if [ -d "$PBS_O_WORKDIR/scripts" ]; then
    cd "$PBS_O_WORKDIR"
elif [ -d "$HOME/AraPPLM/scripts" ]; then
    cd "$HOME/AraPPLM"
elif [ -d "$HOME/AIS5281-Plant-PPLM/scripts" ]; then
    cd "$HOME/AIS5281-Plant-PPLM"
fi

echo "=== Benchmark Job started on $(hostname) at $(date) ==="
echo "Working directory: $(pwd)"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

nvidia-smi

# Load conda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniforge3/etc/profile.d/conda.sh"
fi

conda activate PPLM_NSCC_A100

echo "Python binary: $(which python)"
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

mkdir -p results

ARABIDOPSIS_SEQ_DB="data/arabidopsis/uniprot_final.pkl"
RICE_SEQ_DB="data/rice/uniprot_rice_final.pkl"
BATCH_SIZE=8

# ------------------------------------------------------------------------------
# 1. Benchmark Task 1: C1 Sample
# ------------------------------------------------------------------------------
echo -e "\n>>> [1/4] Running Benchmark: Task 1 (C1 Sample) <<<"
python scripts/batch_predict.py \
    --input data/DeepAraPPI/c1_ppi_sample_DeepAraPPI.txt \
    --output results/deepara_c1_scores.csv \
    --batch_size $BATCH_SIZE \
    --gpu_id 0 \
    --seq_db "$ARABIDOPSIS_SEQ_DB"

# ------------------------------------------------------------------------------
# 2. Benchmark Task 2: C2 Sample (One Unseen Protein)
# ------------------------------------------------------------------------------
echo -e "\n>>> [2/4] Running Benchmark: Task 2 (C2 Sample - One Unseen) <<<"
python scripts/batch_predict.py \
    --input data/DeepAraPPI/c2_ppi_sample_DeepAraPPI.txt \
    --output results/deepara_c2_scores.csv \
    --batch_size $BATCH_SIZE \
    --gpu_id 0 \
    --seq_db "$ARABIDOPSIS_SEQ_DB"

# ------------------------------------------------------------------------------
# 3. Benchmark Task 3: C3 Sample (Both Unseen Proteins)
# ------------------------------------------------------------------------------
echo -e "\n>>> [3/4] Running Benchmark: Task 3 (C3 Sample - Both Unseen) <<<"
python scripts/batch_predict.py \
    --input data/DeepAraPPI/c3_ppi_sample_DeepAraPPI.txt \
    --output results/deepara_c3_scores.csv \
    --batch_size $BATCH_SIZE \
    --gpu_id 0 \
    --seq_db "$ARABIDOPSIS_SEQ_DB"

# ------------------------------------------------------------------------------
# 4. Benchmark Task 4: Rice Cross-Species Generalization
# ------------------------------------------------------------------------------
if [ -f "$RICE_SEQ_DB" ]; then
    echo -e "\n>>> [4/4] Running Benchmark: Task 4 (Rice Cross-Species) <<<"
    python scripts/batch_predict.py \
        --input data/DeepAraPPI/all_rice_positive_negative_DeepAraPPI.txt \
        --output results/deepara_rice_scores.csv \
        --batch_size $BATCH_SIZE \
        --gpu_id 0 \
        --seq_db "$RICE_SEQ_DB"
else
    echo -e "\n⚠️ Rice sequence database not found at $RICE_SEQ_DB. Skipping Task 4."
fi

# ------------------------------------------------------------------------------
# 5. Evaluate All Predictions Against DeepAraPPI Baselines
# ------------------------------------------------------------------------------
echo -e "\n>>> Running Comprehensive Evaluation <<<"
python scripts/evaluate_pplm.py \
    --c1 results/deepara_c1_scores.csv \
    --c2 results/deepara_c2_scores.csv \
    --c3 results/deepara_c3_scores.csv \
    --rice results/deepara_rice_scores.csv \
    --output_dir results/

echo "=== All Benchmarks Completed at $(date) ==="
